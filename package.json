{
  "name": "invasao-exe",
  "version": "3.0.0",
  "private": true,
  "description": "INVASÃO.EXE — RPG de digitação hacker para o Observatório de Cursos (Sistemas de Informação)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --project=jogo --project=desempenho",
    "pretest:e2e:robo": "npm run build",
    "test:e2e:robo": "playwright test --project=robo",
    "test:e2e:update": "playwright test --project=jogo --update-snapshots",
    "test:mutation": "stryker run",
    "validar": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:e2e",
    "icone": "node scripts/gerar-icone.ts && tauri icon src-tauri/app-icon.png",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
