{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InvasaoExe",
  "version": "../package.json",
  "identifier": "br.observatorio.invasaoexe",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "INVASÃO.EXE",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "fullscreen": true,
        "resizable": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "RPG de digitação hacker",
    "longDescription": "INVASÃO.EXE — RPG de digitação hacker do Observatório de Cursos (Sistemas de Informação).",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"] }
    }
  }
}
